{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "suachua",
	"main": "backend/src/index.ts",
	"compatibility_date": "2026-07-16",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Cron 15 phut: keo don bao hanh Odoo tu dvbh + day trang thai gui sua nguoc ve dvbh
	// (backend/src/lib/odooSync.ts, CLAUDE.md muc "Keo don bao hanh Odoo").
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	// run_worker_first la BAT BUOC - bai hoc port tu ca dvbh lan linh-kien-app (xem CLAUDE.md 2 repo
	// do): thieu no thi request navigate that (Sec-Fetch-Mode: navigate) se bi Workers Static Assets
	// SPA fallback chan truoc khi toi duoc Worker, curl KHONG tai hien duoc loi nay. Dung xoa dong nay.
	"assets": {
		"directory": "./frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// database_id la PLACEHOLDER - dien sau khi chay "wrangler d1 create" that (xem DEPLOY.md buoc 2).
	// Worker "suachua" da online that (nguoi dung xac nhan 04/09/2026) nhung hien la ban rong/
	// placeholder - repo nay (gui-bao-hanh-linh-kien) la nguon that se lap day Worker do (xem CLAUDE.md
	// muc "Cau hoi #6 chot xong...").
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sua-chua-bao-hanh-db",
			"database_id": "6d269b54-3999-4408-9699-790d09a462a9",
			"migrations_dir": "migrations"
		},
		{
			"binding": "sua_chua_bao_hanh_db",
			"database_name": "sua-chua-bao-hanh-db",
			"database_id": "6d269b54-3999-4408-9699-790d09a462a9",
			"remote": true
		}
	],
	// Dong bo danh ba/linh kien tu linh-kien-app van la co che DAY (push, routes/sync.ts). Cron duy nhat
	// (triggers o tren) la keo don bao hanh Odoo tu dvbh - 04/10/2026.
	// Khong co "r2_buckets" - khong dung R2, dung quy uoc voi ca dvbh lan linh-kien-app.
	// Service Binding toi dvbh (tra cuu case_dvbh theo ID - case-lookup, xem CLAUDE.md muc "Lien he he
	// thong chinh") - dung Service Binding chu KHONG fetch() thang URL, vi 2 Worker cung 1 tai khoan
	// Cloudflare se bi chan error code 1042 (chong SSRF) - xem giai thich day du trong CLAUDE.md cua
	// linh-kien-app (lib/caseLookupClient.ts). "remote": true de "wrangler dev" local cung dispatch
	// toi ban DA DEPLOY that cua dvbh thay vi tim 1 "wrangler dev" khac dang chay local cho no.
	// Them 2026-09-07: "KHOVAN_PUSH_SERVICE" - Service Binding toi Worker "khovan" (he Quan ly hang ve
	// kho, doc lap) - bao truoc thung hang "cho xu ly" luc KTV xac nhan da gui xe (sua cung ngay, xem
	// lib/khovanPushClient.ts - khong con day ngay luc tao phieu nhap nua). Cung ly do Service Binding
	// nhu CASE_LOOKUP_SERVICE o tren (cung 1 tai khoan Cloudflare).
	"services": [
		{
			"binding": "CASE_LOOKUP_SERVICE",
			"service": "dvbh",
			"remote": true
		},
		{
			"binding": "KHOVAN_PUSH_SERVICE",
			"service": "khovan",
			"remote": true
		}
	],
	"vars": {
		"BOOTSTRAP_ADMIN_EMAIL": "smarttrade.vp@gmail.com",
		"GOOGLE_REDIRECT_URI": "https://suachua.dichvu3t.workers.dev/api/auth/callback",
		"FRONTEND_URL": "https://suachua.dichvu3t.workers.dev",
		// Diem noi toi he DVBH goc (tra cuu case_dvbh theo ID, khong ghi) - xem
		// backend/src/lib/caseLookupClient.ts (Giai doan 5, chua viet o Giai doan 1).
		"CASE_LOOKUP_BASE_URL": "https://dvbh.dichvu3t.workers.dev",
		// Them 2026-09-07: diem noi toi Worker "khovan" (chieu GHI - bao truoc thung hang "cho xu ly",
		// xem KHOVAN_PUSH_SERVICE o tren).
		"KHOVAN_PUSH_BASE_URL": "https://khovan.dichvu3t.workers.dev"
	}
	// Cac gia tri NHAY CAM (khong dat trong "vars" - dat qua "wrangler secret put", xem DEPLOY.md):
	// GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET, CASE_LOOKUP_API_KEY.
	// Giai doan 5 se can them: LINHKIEN_SYNC_API_KEY (xac thuc du lieu day tu linh-kien-app - xem
	// CLAUDE.md muc "Chot 5 cau hoi mo..."), va (tuong lai) VAPID_SERVER_PRIVATE_KEY neu lam Web Push
	// (Giai doan 6, xem "Phan-Tich-Va-Ke-Hoach-Chuyen-Doi-Cloudflare.md" muc 6).
	// Them 2026-09-07: KHOVAN_PUSH_API_KEY (gia tri = api_key cua dong external_systems da tao san
	// trong khovan cho "suachua", Settings > He thong lien quan, code=suachua - dung khi PUSH thung
	// hang sang khovan) va KHOVAN_LOOKUP_API_KEY (secret dung chung 1-1, PHAI dat gia tri GIONG HET
	// truong lookup_api_key cua dong external_systems do ben khovan - dung khi khovan GOI VAO
	// routes/khovanLookup.ts de tra cuu lai).
	// Them 2026-09-07 (nguyen tac "Kho chi thao tac qua app kho van"): KHOVAN_PARTNER_API_KEY (secret
	// dung chung 1-1, PHAI dat gia tri GIONG HET truong action_api_key cua dong external_systems
	// code=suachua ben khovan - dung khi khovan GOI VAO routes/partnerKho.ts de THAY DOI trang thai,
	// TACH RIENG khoi KHOVAN_LOOKUP_API_KEY o tren vi day la quyen GHI, khong phai chi doc).
}